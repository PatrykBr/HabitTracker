# MongoDB connection string (MongoDB Atlas or a local mongod)
# e.g. mongodb+srv://user:pass@cluster0.example.mongodb.net
MONGODB_URI=

# Database name (optional, defaults to "reset-tracker")
MONGODB_DB=reset-tracker

# Better Auth secret — generate with: openssl rand -base64 32
# (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=

# Base URL of the app, used by Better Auth for cookies/origin checks
BETTER_AUTH_URL=http://localhost:3000
