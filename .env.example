# MongoDB connection string (MongoDB Atlas or a local mongod)
# e.g. mongodb+srv://user:pass@cluster0.example.mongodb.net
MONGODB_URI=

# Database name (optional, defaults to "reset-tracker")
MONGODB_DB=reset-tracker

# Generate the Better Auth secret with openssl rand -base64 32.
# Or run bun -e "console.log(crypto.randomBytes(32).toString('base64'))".
BETTER_AUTH_SECRET=

# Base URL of the app, used by Better Auth for cookies/origin checks
BETTER_AUTH_URL=http://localhost:3000

# Leave false for direct connections to the Bun production server. Set true
# only behind a proxy that sets X-Forwarded-For to one verified client IP and
# blocks direct untrusted access to the backend. Otherwise callers can bypass
# authentication rate limits.
TRUST_PROXY=false
