# MongoDB connection string (MongoDB Atlas or a local mongod)
# e.g. mongodb+srv://user:pass@cluster0.example.mongodb.net
MONGODB_URI=

# Database name (optional, defaults to "reset-tracker")
MONGODB_DB=reset-tracker

# Better Auth secret — generate with: openssl rand -base64 32
# (or: bun -e "console.log(crypto.randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=

# Base URL of the app, used by Better Auth for cookies/origin checks
BETTER_AUTH_URL=http://localhost:3000

# Bun production server: leave false for direct connections. Set true only
# behind a proxy that sets X-Forwarded-For to one verified client IP AND blocks
# direct access to the backend; otherwise callers can bypass auth rate limits.
TRUST_PROXY=false
