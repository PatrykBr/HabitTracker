{
  "name": "reset-tracker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "bun --bun tsr generate",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production bun server.ts",
    "preview": "bun run start",
    "typecheck": "bun check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "dev:mongo": "bun scripts/dev-mongo.mjs",
    "generate:pwa-assets": "bun scripts/generate-pwa-assets.mjs",
    "smoke:data": "bun --no-env-file scripts/smoke-data.mjs",
    "smoke:server": "bun --no-env-file scripts/smoke-server.mjs",
    "smoke:ui": "bun --no-env-file scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "^1.6.25",
    "mongodb": "^7.5.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-core": "1.171.34",
    "@types/bun": "1.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "1.64.1",
    "seroval": "^1.6.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "@tanstack/react-start": "1.168.60",
    "seroval": "^1.6.9"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss",
    "mongodb-memory-server",
    "sharp"
  ]
}
